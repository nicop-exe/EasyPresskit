rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Tech Riders: Public Read, Write only by Owner
    match /tech-riders/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('application/pdf');
    }

    // Background Images: Public Read, Write only by Owner
    match /backgrounds/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Profile Pictures (Pro): Public Read, Write only by Owner, max 20MB
    match /profile-pics/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Gallery Images (Pro): Public Read, Write only by Owner, max 20MB
    match /gallery/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
